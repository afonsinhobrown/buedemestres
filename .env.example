# Bué de Mestres — Variáveis de Ambiente
# Copiar para .env.local e preencher os valores reais

# === BASE DE DADOS (Supabase — PostgreSQL) ===
# Usar a connection string do pooler: Project Settings > Database > Connection string > Connection pooling
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?pgbouncer=true

# === APP ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === AUTH (JWT secret para autenticação própria) ===
AUTH_SECRET=GERAR_COM_openssl_rand_base64_32

# === E-MAIL ===
RESEND_API_KEY=

# === PAGAMENTOS ===
PAYMENT_PROVIDER=manual        # manual | mpesa | emola
WEBHOOK_SECRET=

# M-Pesa (Fase 8)
MPESA_API_HOST=
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=

# e-Mola (Fase 8)
EMOLA_API_HOST=
EMOLA_API_KEY=

# === ARMAZENAMENTO (opcional — Cloudinary ou S3-compatible) ===
# STORAGE_PROVIDER=local
# CLOUDINARY_URL=

# === PAYSUITE (pagamentos online M-Pesa/e-Mola/Cartão) ===
PAYSUITE_API_URL=https://paysuite.tech/api/v1
PAYSUITE_API_TOKEN=<token-do-backoffice-paysuite>
PAYSUITE_WEBHOOK_SECRET=whsec_<segredo-do-webhook>
PAYSUITE_WEBHOOK_URL=https://<APP_URL>/api/webhooks/paysuite
