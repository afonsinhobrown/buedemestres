  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "dotenv": "^18.0.4",
    "pg": "^8.23.0"
  },
  "pnpm": {
    "overrides": {
      "electron-to-chromium": "1.5.442",
      "ignore": "7.0.10"
    }
  }
